 "components": {
  "schemas": {
   "AdvanceIn": {
    "properties": {
     "weeks": {
      "type": "integer",
      "maximum": 12.0,
      "minimum": 1.0,
      "title": "Weeks"
     },
     "shocks": {
      "items": {
       "$ref": "#/components/schemas/Shock"
      },
      "type": "array",
      "maxItems": 4,
      "title": "Shocks",
      "description": "what really happens in the weeks being generated; the desk only sees the data"
     }
    },
    "type": "object",
    "required": [
     "weeks"
    ],
    "title": "AdvanceIn"
   },
   "EventIn": {
    "properties": {
     "commodity_id": {
      "type": "string",
      "format": "uuid",
      "title": "Commodity Id"
     },
     "event_type": {
      "type": "string",
      "enum": [
       "mine_outage",
       "port_congestion",
       "policy",
       "strike",
       "weather",
       "other"
      ],
      "title": "Event Type"
     },
     "region": {
      "type": "string",
      "maxLength": 40,
      "title": "Region"
     },
     "occurred_at": {
      "type": "string",
      "format": "date-time",
      "title": "Occurred At"
     },
     "severity": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Severity"
     },
     "source_uri": {
      "type": "string",
      "maxLength": 300,
      "minLength": 8,
      "title": "Source Uri"
     },
     "detail": {
      "additionalProperties": true,
      "type": "object",
      "title": "Detail"
     }
    },
    "type": "object",
    "required": [
     "commodity_id",
     "event_type",
     "region",
     "occurred_at",
     "severity",
     "source_uri"
    ],
    "title": "EventIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "NowcastIn": {
    "properties": {
     "commodity_id": {
      "type": "string",
      "format": "uuid",
      "title": "Commodity Id"
     }
    },
    "type": "object",
    "required": [
     "commodity_id"
    ],
    "title": "NowcastIn"
   },
   "ScenarioIn": {
    "properties": {
     "commodity_id": {
      "type": "string",
      "format": "uuid",
      "title": "Commodity Id"
     },
     "shocks": {
      "items": {
       "$ref": "#/components/schemas/Shock"
      },
      "type": "array",
      "maxItems": 4,
      "minItems": 1,
      "title": "Shocks"
     },
     "weeks": {
      "type": "integer",
      "maximum": 26.0,
      "minimum": 4.0,
      "title": "Weeks",
      "default": 12
     },
     "runs": {
      "type": "integer",
      "maximum": 2000.0,
      "minimum": 100.0,
      "title": "Runs",
      "default": 400
     }
    },
    "type": "object",
    "required": [
     "commodity_id",
     "shocks"
    ],
    "title": "ScenarioIn"
   },
   "Shock": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "outage",
       "congestion"
      ],
      "title": "Kind"
     },
     "region": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Region",
      "description": "mine region for an outage"
     },
     "port": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Port",
      "description": "port for congestion"
     },
     "start": {
      "type": "integer",
      "maximum": 52.0,
      "minimum": 0.0,
      "title": "Start",
      "description": "weeks from now",
      "default": 1
     },
     "weeks": {
      "type": "integer",
      "maximum": 52.0,
      "minimum": 1.0,
      "title": "Weeks"
     },
     "cut": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 1.0,
        "minimum": 0.05
       },
       {
        "type": "null"
       }
      ],
      "title": "Cut",
      "description": "share of production lost"
     },
     "extra_weeks": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 8.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Extra Weeks",
      "description": "extra transit weeks"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "weeks"
    ],
    "title": "Shock"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}